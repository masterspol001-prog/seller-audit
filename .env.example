# SettleProof environment variables
# Copy to .env and fill in. The server reads these directly from the process env.

# development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# Directory for the SQLite database and uploaded files
DATA_DIR=./data

# Secret used to sign sessions. REQUIRED in production; generate with: openssl rand -hex 32
APP_SECRET=

# How long a login session stays valid
SESSION_TTL_HOURS=336

# Largest upload accepted, in bytes (default 25 MB)
MAX_UPLOAD_BYTES=26214400

# How many days uploaded files and audits are kept before automatic deletion
RETENTION_DAYS=30

# Allow new account sign-ups (true | false)
ALLOW_SIGNUP=true

# info | warn | error
LOG_LEVEL=info

# Set to true when running behind a trusted reverse proxy (affects client IP)
TRUST_PROXY=false

# Rate limiting
RATE_WINDOW_MS=60000
RATE_MAX=120
RATE_AUTH_MAX=20

# --- Billing ---
# Global prices are USD: Seller $10/mo, Accountant $29/mo, one-off report $10.
# Prefer Stripe for worldwide cards. Razorpay is optional for India.
# With neither set, checkout records a manual intent. In non-production the
# UI can complete that intent so the rest of the product can be tested.

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# POST /api/billing/webhook/razorpay — signatures are verified with this secret.
RAZORPAY_WEBHOOK_SECRET=

# Secret required by POST /api/billing/admin/{activate,cancel} and GET /api/billing/admin/outbox
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Public https URL of this deployment, used for payment callback and referral links
PUBLIC_BASE_URL=http://localhost:3000

# Account credit granted to a referrer when their referral activates a paid plan
REFERRAL_CREDIT=500
